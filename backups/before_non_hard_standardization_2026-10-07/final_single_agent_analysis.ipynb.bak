    "# EFR: explicitly read CSV and show With_Store vs No_Store average per model\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "\n",
    "csv_path = 'eval_results_normalized.csv'\n",
    "try:\n",
    "    src = pd.read_csv(csv_path)\n",
    "except FileNotFoundError:\n",
    "    print(f'CSV not found: {csv_path}')\n",
    "    src = pd.DataFrame()\n",
    "\n",
    "if src.empty:\n",
    "    print('Source CSV is empty or missing.')\n",
    "else:\n",
    "    if 'Summary_Metric' not in src.columns:\n",
    "        print('CSV missing Summary_Metric column')\n",
    "    else:\n",
    "        efr = src[src['Summary_Metric'] == 'EFR_Extraction_Failure_Rate'].copy()\n",
    "        if efr.empty:\n",
    "            print('No EFR_Extraction_Failure_Rate rows found in CSV')\n",
    "        else:\n",
    "            efr['Value'] = pd.to_numeric(efr['Value'], errors='coerce')\n",
    "            if 'Condition' not in efr.columns:\n",
    "                efr['Condition'] = 'Unknown'\n",
    "            # Normalize Condition labels\n",
    "            efr['Condition'] = efr['Condition'].replace({'WithStore':'With_Store','NoStore':'No_Store'})\n",
    "            pivot = (\n",
    "                efr.pivot_table(index='Model', columns='Condition', values='Value', aggfunc='mean')\n",
    "                   .fillna(0.0)\n",
    "            )\n",
    "            # Reorder columns\n",
    "            cols_order = [c for c in ['With_Store','No_Store'] if c in pivot.columns]\n",
    "            other_cols = [c for c in pivot.columns if c not in cols_order]\n",
    "            pivot = pivot[cols_order + other_cols]\n",
    "            pivot = pivot.reset_index()\n",
    "            print('Average EFR per model (With_Store vs No_Store):')\n",
    "            display(pivot.round(4))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d263eba5",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "df_with_store_v16_only = pd.read_csv(\"eval_results_with_store.csv\")\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5d59e845",
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "metric_name = \"Average_Evidence_F1\"\n",
    "\n",
    "# Filter df_with_store to v15 eval prompt version\n",
    "ver_col = \"Eval_Prompt_Ver\" if \"Eval_Prompt_Ver\" in df_with_store.columns else \"Eval_Version\"\n",
    "if ver_col not in df_with_store.columns:\n",
    "    raise ValueError(\"No Eval_Prompt_Ver or Eval_Version column found in df_with_store\")\n",
    "\n",
    "filtered_df_with_store = df_with_store[\n",
    "    df_with_store[ver_col].astype(str).str.strip().str.lower() == \"v15\"\n",
    "].copy()\n",
    "\n",
    "\n",
    "def get_evidence_f1_from_summary(df: pd.DataFrame, value_col: str) -> pd.DataFrame:\n",
    "    if \"Summary_Metric\" not in df.columns:\n",
    "        raise ValueError(\"Summary_Metric column not found\")\n",
    "    if value_col not in df.columns:\n",
    "        raise ValueError(f\"{value_col} column not found in DataFrame\")\n",
    "    if \"Model\" not in df.columns:\n",
    "        raise ValueError(\"Model column not found\")\n",
    "\n",
    "    sub = df[df[\"Summary_Metric\"].astype(str).str.strip() == metric_name].copy()\n",
    "    if sub.empty:\n",
    "        raise ValueError(f\"No rows found for Summary_Metric = {metric_name}\")\n",
    "\n",
    "    if \"rename_map\" in globals():\n",
    "        sub[\"Model\"] = sub[\"Model\"].replace(rename_map)\n",
    "\n",
    "    sub[value_col] = pd.to_numeric(sub[value_col], errors=\"coerce\")\n",
    "    return (\n",
    "        sub.groupby(\"Model\", as_index=False)[value_col]\n",
    "        .mean()\n",
    "        .rename(columns={value_col: \"evidence_f1\"})\n",
    "    )\n",
    "\n",
    "\n",
    "# v15 from normalized results (Value column)\n",
    "v15_by_model = get_evidence_f1_from_summary(filtered_df_with_store, \"Value\").rename(\n",
    "    columns={\"evidence_f1\": \"v15\"}\n",
    ")\n",
    "\n",
    "# v16 from with_store csv (With_Store column)\n",
    "pv_col = \"Prompt_Ver\" if \"Prompt_Ver\" in df_with_store_v16_only.columns else \"Eval_Prompt_Ver\"\n",
    "if pv_col not in df_with_store_v16_only.columns:\n",
    "    raise ValueError(\"No Prompt_Ver or Eval_Prompt_Ver column found in df_with_store_v16_only\")\n",
    "\n",
    "v16_df = df_with_store_v16_only[\n",
    "    df_with_store_v16_only[pv_col].astype(str).str.contains(\"v16\", case=False, na=False)\n",
    "].copy()\n",
    "\n",
    "v16_value_col = \"With_Store\" if \"With_Store\" in v16_df.columns else \"Value\"\n",
    "v16_by_model = get_evidence_f1_from_summary(v16_df, v16_value_col).rename(\n",
    "    columns={\"evidence_f1\": \"v16\"}\n",
    ")\n",
    "\n",
    "compare = v15_by_model.merge(v16_by_model, on=\"Model\", how=\"outer\")\n",
    "compare = compare.sort_values(by=\"Model\")\n",
    "\n",
    "ax = compare.set_index(\"Model\")[[\"v15\", \"v16\"]].plot(\n",
    "    kind=\"bar\",\n",
    "    figsize=(12, 6),\n",
    ")\n",
    "ax.set_title(\"Average Evidence F1 by Model: v15 vs v16 (With Store)\")\n",
    "ax.set_ylabel(\"Average Evidence F1\")\n",
    "ax.set_xlabel(\"Model\")\n",
    "plt.xticks(rotation=0, ha=\"center\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "plt.close(ax.figure)\n",
    "\n",
    "compare.head()"
   ]
  },
