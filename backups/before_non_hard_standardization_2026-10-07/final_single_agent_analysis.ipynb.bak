   "source": [
    "## Standard Deviation Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dcb11bf6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Standard Deviation of Accuracy across runs, averaged across domains\n",
    "std_raw_df = df_clean.copy()\n",
    "std_raw_df[model_column] = std_raw_df[model_column].replace(rename_map)\n",
    "\n",
    "# Filter for StdDev_Raw_Score metric\n",
    "std_raw_df = std_raw_df[\n",
    "    std_raw_df[\"Summary_Metric\"].astype(str).str.strip() == \"StdDev_Raw_Score\"\n",
    "].copy()\n",
    "std_raw_df[\"Value\"] = pd.to_numeric(std_raw_df[\"Value\"], errors='coerce')\n",
    "\n",
    "# Extract scenario type\n",
    "std_raw_df[\"scenario_type\"] = std_raw_df[\"Domain\"].apply(extract_scenario_type)\n",
    "std_raw_df = std_raw_df[std_raw_df[\"scenario_type\"].isin(scenario_types)]\n",
    "\n",
    "std_raw_summary = (\n",
    "    std_raw_df.groupby([model_column, \"scenario_type\", \"Condition\"], as_index=False)[\"Value\"]\n",
    "    .mean()\n",
    ")\n",
    "\n",
    "std_raw_pivot = std_raw_summary.pivot_table(\n",
    "    index=[model_column, \"scenario_type\"],\n",
    "    columns=\"Condition\",\n",
    "    values=\"Value\"\n",
    ").reset_index()\n",
    "\n",
    "std_raw_pivot.columns.name = None\n",
    "std_raw_pivot = std_raw_pivot.rename(\n",
    "    columns={\n",
    "        CONFIG[\"with_store_label\"]: \"with_store_std_runs\",\n",
    "        CONFIG[\"no_store_label\"]: \"no_store_std_runs\",\n",
    "    }\n",
    ")\n",
    "std_raw_pivot = std_raw_pivot.sort_values(by=[model_column, \"scenario_type\"])\n",
    "\n",
    "print(\"Run-Level Consistency (Mean of StdDev_Raw_Score across domains):\")\n",
    "display(std_raw_pivot)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0c715e4a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Run-Level Std Dev: Average of run-level standard deviations across all scenarios\n",
    "std_raw_df = df_clean.copy()\n",
    "std_raw_df[model_column] = std_raw_df[model_column].replace(rename_map)\n",
    "\n",
    "std_raw_df = std_raw_df[\n",
    "    (std_raw_df[\"Summary_Metric\"].astype(str).str.strip() == \"StdDev_Raw_Score\")\n",
    "    & (std_raw_df[\"Domain\"].apply(extract_scenario_type).isin(scenario_types))\n",
    "].copy()\n",
    "std_raw_df[\"Value\"] = pd.to_numeric(std_raw_df[\"Value\"], errors='coerce')\n",
    "\n",
    "run_std_all = std_raw_df.groupby([model_column, \"Condition\"])[\"Value\"].mean().unstack().reset_index()\n",
    "run_std_all = run_std_all.rename(columns={\n",
    "    CONFIG[\"with_store_label\"]: \"with_store_std_runs\",\n",
    "    CONFIG[\"no_store_label\"]: \"no_store_std_runs\"\n",
    "})\n",
    "\n",
    "# 2. Domain/Scenario-Level Std Dev: Std dev of the Average_Accuracy values across all scenarios/domains\n",
    "acc_df = df_clean.copy()\n",
    "acc_df[model_column] = acc_df[model_column].replace(rename_map)\n",
    "\n",
    "acc_df = acc_df[\n",
    "    (acc_df[\"Summary_Metric\"].astype(str).str.strip() == \"Average_Accuracy\")\n",
    "    & (acc_df[\"Domain\"].apply(extract_scenario_type).isin(scenario_types))\n",
    "].copy()\n",
    "acc_df[\"Value\"] = pd.to_numeric(acc_df[\"Value\"], errors='coerce')\n",
    "\n",
    "domain_std_all = acc_df.groupby([model_column, \"Condition\"])[\"Value\"].std().unstack().reset_index()\n",
    "domain_std_all = domain_std_all.rename(columns={\n",
    "    CONFIG[\"with_store_label\"]: \"with_store_std_scenarios\",\n",
    "    CONFIG[\"no_store_label\"]: \"no_store_std_scenarios\"\n",
    "})\n",
    "\n",
    "# Merge them together\n",
    "final_std_df = pd.merge(run_std_all, domain_std_all, on=model_column)\n",
    "print(\"Standard Deviation Per Model (Aggregated across all scenarios):\")\n",
    "display(final_std_df)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "74f75b1b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Corrected cell for standard deviations\n",
    "scenario_df = df_clean.copy()\n",
    "\n",
    "# 1. Extract the scenario type and add it as a new column\n",
    "scenario_df[\"scenario_type\"] = scenario_df[\"Domain\"].apply(extract_scenario_type)\n",
    "\n",
    "# 2. Filter for accuracy metric and valid scenario types\n",
    "scenario_df = scenario_df[\n",
    "    (scenario_df[\"Summary_Metric\"].astype(str).str.strip() == \"Average_Accuracy\")\n",
    "    & (scenario_df[\"scenario_type\"].isin(scenario_types))\n",
    "].copy()\n",
    "\n",
    "scenario_df[\"Value\"] = pd.to_numeric(scenario_df[\"Value\"], errors='coerce')\n",
    "\n",
    "# 3. Group and pivot\n",
    "scenario_std = scenario_df.groupby([\"scenario_type\", \"Condition\"])[\"Value\"].std().unstack().reset_index()\n",
    "display(scenario_std)\n",
    "\n"
   ]
