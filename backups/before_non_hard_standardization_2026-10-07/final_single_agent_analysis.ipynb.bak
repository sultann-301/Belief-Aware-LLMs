    "    m15.plot.bar(x=model_column, y=['with_store_v15', 'no_store_v1'], ax=axes[0])\n",
    "    axes[0].set_title('Model-level: With_Store v15 vs No_Store v1')\n",
    "    axes[0].set_ylabel('Average Accuracy')\n",
    "else:\n",
